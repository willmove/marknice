# 复制本文件为 .env 并填入真实值后再启动 server。
# .env 已在 .gitignore 中忽略，不会被提交。

# 服务监听端口（默认 8080）
PORT=8080

# 必填：PaddleOCR Bearer Token
# 申请地址：https://aistudio.baidu.com/
PADDLE_OCR_TOKEN=

# 可选：覆盖 PaddleOCR API 端点
# PADDLE_OCR_BASE=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# 可选：/api/proxy 允许透传的主机后缀（逗号分隔，默认覆盖 PaddleOCR 与百度对象存储）
# PROXY_ALLOWED_HOSTS=.aistudio-app.com,.bcebos.com

# 可选：匿名用户本地图片复制到公众号时的 OSS 临时图床
# 建议使用仅允许 PutObject 到 temp/* 的 RAM 子账号 AccessKey，不要使用主账号 AccessKey。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=marknice
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_TEMP_PREFIX=temp/
# 可选：默认给对象设置 public-read；如果你用 Bucket Policy 公开 temp/*，可设为 none
# OSS_OBJECT_ACL=public-read

# 可选：如果绑定了 OSS 自定义域名，填公网访问基址；否则默认使用 https://<bucket>.<endpoint>
# OSS_PUBLIC_BASE_URL=https://img.marknice.cn

# 可选：匿名上传风控限制
# OSS_MAX_IMAGES=12
# OSS_MAX_IMAGE_BYTES=2097152
# OSS_MAX_REQUEST_BYTES=31457280
